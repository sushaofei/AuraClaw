# 测试环境（DEV_SERVICE Docker Compose，部署机 10.244.16.131）。
#
#   cp .env.test.example .env.test
#   在 gitignored .host.env 填写 KINGBASE_HOST/PORT/USER/PWD，然后同步数据库段：
#   uv run python scripts/sync_kingbase_env.py
#   填入镜像、模型、Vault、对象存储、令牌（chmod 600，勿提交）
#   uv run python scripts/materialize_compose_secrets.py \
#     --env-file .env.test --output-dir .runtime/compose-secrets
#   uv run python scripts/compose_preflight.py --env-file .env.test
#   docker compose --env-file .env.test -f compose.test.yml up -d --wait
#
# 主存储：云 KingBase V9（PostgreSQL 兼容模式）。凭证直接写在本文件 Database 段。
# 迁移目录 /app/migrations（PostgreSQL 方言树）。
# 与 .env.dev 除大模型与本地运行拓扑外保持一致；.env.prod 当前与测试环境对齐。
# 不含 NO_PROXY：服务器环境无本机 HTTP 代理问题。
# 服务间 URL 由 compose.test.yml 覆盖为容器 DNS，下方 12 入口段仅作占位。

# --- 进程与策略 ---
AURACLAW_DEPLOYMENT_PROFILE=production
AURACLAW_LOG_LEVEL=INFO
AURACLAW_HOST=0.0.0.0
AURACLAW_STORAGE_BACKEND=kingbase
AURACLAW_RUNTIME_EVENT_BACKEND=kafka
AURACLAW_ALLOW_INSECURE_IDENTITY_HEADERS=false
AURACLAW_WORKER_WAKE_ENABLED=true
AURACLAW_WORKER_IDLE_INTERVAL=0.25
AURACLAW_PROJECTION_WORKER_INTERVAL=0.1
AURACLAW_ORCHESTRATOR_WORKER_INTERVAL=0.1
AURACLAW_ORCHESTRATOR_LEASE_TTL_SECONDS=300
AURACLAW_SYNC_INVOKE_DEFAULT_TIMEOUT_SECONDS=60
AURACLAW_SYNC_INVOKE_MAX_TIMEOUT_SECONDS=120
AURACLAW_SYNC_INVOKE_POLL_INTERVAL_SECONDS=0.25
AURACLAW_SYNC_INVOKE_MAX_CONCURRENT=32
AURACLAW_HANDS_MAX_CONCURRENT=32
AURACLAW_HANDS_MAX_CONCURRENT_PER_TENANT=8
AURACLAW_HANDS_MAX_QUEUED=256
AURACLAW_HANDS_MAX_QUEUED_PER_TENANT=32
AURACLAW_HANDS_QUEUE_TIMEOUT_SECONDS=5
AURACLAW_SKILL_RELIABILITY_MAX_CONCURRENT=8
AURACLAW_SKILL_RELIABILITY_CLAIM_TTL_SECONDS=30
AURACLAW_SKILL_CONTENT_CACHE_MAX_BYTES=67108864
AURACLAW_SKILL_CONTENT_CACHE_MAX_ENTRIES=1024
AURACLAW_SKILL_CONTENT_CACHE_TTL_SECONDS=3600
AURACLAW_RUNTIME_SKILL_CONTENT_CACHE_MAX_BYTES=16777216
AURACLAW_RUNTIME_SKILL_CONTENT_CACHE_MAX_ENTRIES=1024
AURACLAW_RUNTIME_SKILL_CONTENT_CACHE_TTL_SECONDS=900
AURACLAW_RUNTIME_SKILL_PROMPT_MAX_BYTES=262144
AURACLAW_RUNTIME_SKILL_PROMPT_MAX_ESTIMATED_TOKENS=65536
AURACLAW_KAFKA_SKILL_LIFECYCLE_TOPIC=managed-agent.skill-lifecycle
AURACLAW_SKILL_TRANSACTION_RETRY_ATTEMPTS=3
AURACLAW_SKILL_TRANSACTION_RETRY_BASE_DELAY_SECONDS=0.01
AURACLAW_MCP_RECONCILE_MAX_CONCURRENT=8
AURACLAW_MCP_RECONCILE_MAX_CONCURRENT_PER_TENANT=4
AURACLAW_MCP_RECONCILE_MAX_CONCURRENT_PER_HOST=2
AURACLAW_MCP_RECONCILE_SERVER_TIMEOUT_SECONDS=60
AURACLAW_DELIVERY_MAX_CONCURRENT=8
AURACLAW_DELIVERY_MAX_CONCURRENT_PER_TENANT=2
AURACLAW_DELIVERY_CLAIM_TTL_SECONDS=30
AURACLAW_RESOURCE_GATEWAY_MAX_CONCURRENT=32
AURACLAW_RESOURCE_GATEWAY_MAX_QUEUED=128
AURACLAW_RESOURCE_GATEWAY_QUEUE_TIMEOUT_SECONDS=5
AURACLAW_RUNTIME_EVENT_PUBLISH_MAX_CONCURRENT=64
AURACLAW_RUNTIME_EVENT_PUBLISH_MAX_QUEUED=1024
AURACLAW_RUNTIME_EVENT_PUBLISH_QUEUE_TIMEOUT_SECONDS=5
AURACLAW_RUNTIME_EVENT_PUBLISH_TIMEOUT_SECONDS=10
AURACLAW_CORS_ALLOW_ORIGINS=http://10.244.16.130:1420,http://10.244.16.130:3000,http://127.0.0.1:3000,http://localhost:3000
AURACLAW_MCP_ALLOW_PRIVATE_AUTH_NONE=true
AURACLAW_RUNTIME_POLL_INTERVAL=0.05
AURACLAW_INGRESS_ENABLED=true
AURACLAW_INGRESS_PORT=8080

# --- Compose / 发布 ---
AURACLAW_IMAGE=auraclaw:dev
AURACLAW_INTERNAL_NETWORK=auraclaw
AURACLAW_EDGE_NETWORK=auraclaw-edge
AURACLAW_PLATFORM_NETWORK=auraclaw-platform
AURACLAW_SECRET_DIR=.runtime/compose-secrets
AURACLAW_MIGRATIONS_DIRECTORY=/app/migrations
AURACLAW_MIGRATE_TARGET=0055

# --- 12 入口（Compose 内由 compose.test.yml 写成服务 DNS）---
AURACLAW_TASK_API_PORT=8000
AURACLAW_SESSION_PORT=8001
AURACLAW_PROJECTION_PORT=8002
AURACLAW_ORCHESTRATOR_PORT=8003
AURACLAW_RUNTIME_PORT=8004
AURACLAW_MODEL_GATEWAY_PORT=8005
AURACLAW_HANDS_PORT=8006
AURACLAW_POLICY_PORT=8007
AURACLAW_CREDENTIAL_PROXY_PORT=8008
AURACLAW_ARTIFACT_PORT=8009
AURACLAW_STREAMING_PORT=8010
AURACLAW_DELIVERY_PORT=8011
AURACLAW_SESSION_BASE_URL=http://127.0.0.1:8001
AURACLAW_PROJECTION_BASE_URL=http://127.0.0.1:8002
AURACLAW_CONTROL_BASE_URL=http://127.0.0.1:8003
AURACLAW_RUNTIME_BASE_URL=http://127.0.0.1:8004
AURACLAW_MODEL_GATEWAY_BASE_URL=http://127.0.0.1:8005
AURACLAW_HANDS_URL=http://127.0.0.1:8006
AURACLAW_POLICY_BASE_URL=http://127.0.0.1:8007
AURACLAW_CREDENTIAL_PROXY_BASE_URL=http://127.0.0.1:8008
AURACLAW_ARTIFACT_BASE_URL=http://127.0.0.1:8009
AURACLAW_DELIVERY_BASE_URL=http://127.0.0.1:8011

# --- Kafka（DEV_MIDDLEWARE @ 10.244.16.132）---
KAFKA_HOST=10.244.16.132
KAFKA_PORT=9092
AURACLAW_KAFKA_RUNTIME_TOPIC=managed-agent.runtime-events
AURACLAW_KAFKA_STREAMING_GROUP=streaming-ingestor
AURACLAW_RUNTIME_EVENT_RETENTION_EVENTS=1000
AURACLAW_STREAM_CONNECTION_QUEUE_SIZE=128
AURACLAW_STREAM_DELTA_MIN_INTERVAL_SECONDS=0.02

# --- 对象存储 / Artifact ---
# 开发、测试和生产环境统一使用华为 OBS
AURACLAW_ARTIFACT_BACKEND=obs
AURACLAW_ARTIFACT_ROOT=.data/artifacts
AURACLAW_ARTIFACT_MULTIPART_THRESHOLD=16777216
AURACLAW_ARTIFACT_MULTIPART_PART_SIZE=8388608

# --- 华为 OBS（backend=obs）---
OBS_ENDPOINT=obsv3.example.com
OBS_BUCKET=auraclaw-artifacts
OBS_AK=replace-obs-access-key
OBS_SK=replace-obs-secret-key
OBS_REGION=replace-with-obs-region
OBS_USE_SSL=true
OBS_PATH_STYLE=false
OBS_DOMAIN=
OBS_TENANT_ID=

# --- Vault ---
AURACLAW_CREDENTIAL_VAULT_ADDR=http://10.244.16.132:8200
AURACLAW_CREDENTIAL_VAULT_TOKEN=replace-with-vault-token
AURACLAW_CREDENTIAL_VAULT_MOUNT=secret
AURACLAW_CREDENTIAL_EGRESS_ALLOWLIST=
TEST_VAULT_CREDENTIAL_REF=test/auraclaw-credentials
TEST_VAULT_CREDENTIAL_FIELD=password

# --- Model（服务器测试环境；与 .env.dev 仅此段不同）---
AURACLAW_MODEL_PROVIDER=openai_compatible
AURACLAW_MODEL_API_KEY=replace-with-model-api-key
AURACLAW_MODEL_BASE_URL=https://models.example/v1
AURACLAW_MODEL_NAME=replace-with-model-name
AURACLAW_MODEL_TIMEOUT_SECONDS=120
AURACLAW_MODEL_THINKING_ENABLED=false
AURACLAW_MODEL_PROMPT_CACHE_KEY_ENABLED=false

# --- Database（由 scripts/sync_kingbase_env.py 从 .host.env 生成）---
# 以下占位值只用于模板；同步脚本会原子替换整个 Database 段并 URL 编码密码。
AURACLAW_DB_DIALECT=postgres
DB_HOST=10.244.72.1
DB_PORT=54321
DB_USER=replace-with-kingbase-user
DB_PWD=replace-with-kingbase-password
DB_NAME=chaintower_agent
AURACLAW_DATABASE_URL=postgresql+asyncpg://replace-with-kingbase-user:replace-with-kingbase-password-url-encoded@10.244.72.1:54321/chaintower_agent
AURACLAW_MIGRATION_DATABASE_URL=postgresql+asyncpg://replace-with-kingbase-user:replace-with-kingbase-password-url-encoded@10.244.72.1:54321/chaintower_agent

# --- Workload tokens / Agent Context ---
# 各服务身份必须互不相同，且 ≥32 字符。AURACLAW_RUNTIME_WORKLOAD_TOKEN
# 由 agent-runtime 与 action-hands 共用（调用 Hands 的 Bearer）。
AURACLAW_LEASE_SIGNING_KEY=replace-test-lease-signing-key-32bytes-minimum
AURACLAW_TASK_API_WORKLOAD_TOKEN=replace-test-task-api-workload-token-0001
AURACLAW_PROJECTION_WORKLOAD_TOKEN=replace-test-projection-workload-token-02
AURACLAW_ORCHESTRATOR_WORKLOAD_TOKEN=replace-test-orchestrator-workload-tok-03
AURACLAW_RUNTIME_WORKLOAD_TOKEN=replace-test-runtime-workload-token-0004
AURACLAW_MODEL_GATEWAY_WORKLOAD_TOKEN=replace-test-model-gateway-workload-tok05
AURACLAW_ACTION_HANDS_WORKLOAD_TOKEN=replace-test-action-hands-workload-tok-06
AURACLAW_CREDENTIAL_PROXY_WORKLOAD_TOKEN=replace-test-credential-proxy-token-007
AURACLAW_ARTIFACT_SERVICE_WORKLOAD_TOKEN=replace-test-artifact-service-token-008
AURACLAW_POLICY_WORKLOAD_TOKEN=replace-test-policy-workload-token-00009
AURACLAW_DELIVERY_WORKLOAD_TOKEN=replace-test-delivery-workload-token-010
AURACLAW_STREAMING_GATEWAY_WORKLOAD_TOKEN=replace-test-streaming-gateway-workload-token-011
AURACLAW_CHAINTOWER_WORKLOAD_TOKEN=replace-test-chaintower-workload-token-x
AURACLAW_AGENT_CONTEXT_ISSUER=chaintower
AURACLAW_AGENT_CONTEXT_AUDIENCE=auraclaw-task-api
AURACLAW_AGENT_CONTEXT_SIGNING_KEYS_JSON={"k1":"replace-chaintower-agent-context-hmac-key-01"}
AURACLAW_AGENT_CONTEXT_MAX_TTL_SECONDS=300
AURACLAW_AGENT_CONTEXT_CLOCK_SKEW_SECONDS=30
AURACLAW_AGENT_CONTEXT_REQUIRED_SCOPE=agent.task.invoke
AURACLAW_SKILL_SIGNING_KEY=replace-dev-skill-signing-key-16

# --- 基础设施网络 ---
REDIS_HOST=10.244.16.134
REDIS_PORT=6379
REDIS_DB=0
REDIS_PWD=replace-with-redis-password
