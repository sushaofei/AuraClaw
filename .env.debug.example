# Copy to .env.debug (gitignored) before launching any standalone
# AuraClaw service debug configuration.
#
#   cp .env.debug.example .env.debug
#
# 12-process debug uses the same composition as production. These values only
# select local resources (memory storage, local artifacts, shared debug tokens).
# Java MCP reconcile continues to use .env.hands-debug.

AURACLAW_DEPLOYMENT_PROFILE=development
AURACLAW_LOG_LEVEL=DEBUG
AURACLAW_STORAGE_BACKEND=memory
AURACLAW_HOST=127.0.0.1
AURACLAW_RUNTIME_EVENT_BACKEND=memory
AURACLAW_ARTIFACT_BACKEND=local
AURACLAW_WORKER_WAKE_ENABLED=true
AURACLAW_ALLOW_INSECURE_IDENTITY_HEADERS=true
AURACLAW_LEASE_SIGNING_KEY=auraclaw-local-debug-lease-signing-key
AURACLAW_PRICE_INSIGHT_SOURCE=disabled

AURACLAW_TASK_API_WORKLOAD_TOKEN=local-task-api
AURACLAW_PROJECTION_WORKLOAD_TOKEN=local-projection
AURACLAW_ORCHESTRATOR_WORKLOAD_TOKEN=local-orchestrator
AURACLAW_RUNTIME_WORKLOAD_TOKEN=local-runtime
AURACLAW_MODEL_GATEWAY_WORKLOAD_TOKEN=local-model-gateway
AURACLAW_ACTION_HANDS_WORKLOAD_TOKEN=local-action-hands
AURACLAW_POLICY_WORKLOAD_TOKEN=local-policy
AURACLAW_CREDENTIAL_PROXY_WORKLOAD_TOKEN=local-credential-proxy
AURACLAW_ARTIFACT_SERVICE_WORKLOAD_TOKEN=local-artifact-service
AURACLAW_DELIVERY_WORKLOAD_TOKEN=local-delivery

AURACLAW_TASK_API_PORT=8000
AURACLAW_SESSION_PORT=8001
AURACLAW_PROJECTION_PORT=8002
AURACLAW_ORCHESTRATOR_PORT=8003
AURACLAW_RUNTIME_PORT=8004
AURACLAW_MODEL_GATEWAY_PORT=8005
AURACLAW_HANDS_PORT=8006
AURACLAW_POLICY_PORT=8007
AURACLAW_CREDENTIAL_PROXY_PORT=8008
AURACLAW_ARTIFACT_PORT=8009
AURACLAW_STREAMING_PORT=8010
AURACLAW_DELIVERY_PORT=8011

AURACLAW_SESSION_BASE_URL=http://127.0.0.1:8001
AURACLAW_PROJECTION_BASE_URL=http://127.0.0.1:8002
AURACLAW_CONTROL_BASE_URL=http://127.0.0.1:8003
AURACLAW_RUNTIME_BASE_URL=http://127.0.0.1:8004
AURACLAW_MODEL_GATEWAY_BASE_URL=http://127.0.0.1:8005
AURACLAW_HANDS_URL=http://127.0.0.1:8006
AURACLAW_POLICY_BASE_URL=http://127.0.0.1:8007
AURACLAW_CREDENTIAL_PROXY_BASE_URL=http://127.0.0.1:8008
AURACLAW_ARTIFACT_BASE_URL=http://127.0.0.1:8009
AURACLAW_DELIVERY_BASE_URL=http://127.0.0.1:8011
