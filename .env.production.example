# 生产 / DEV_SERVICE Compose 发布配置。
#
#   cp .env.production.example .env.production
#   把 IMAGE、库密码、模型、Vault、SeaweedFS、令牌换成真实值（chmod 600）
#   uv run python scripts/materialize_compose_secrets.py \
#     --env-file .env.production --output-dir .runtime/compose-secrets
#   uv run python scripts/compose_preflight.py --env-file .env.production
#
# 令牌/lease key 至少 32 字符且互不相同：python -c "import secrets; print(secrets.token_urlsafe(32))"
# 角色 DSN 用户名必须与 deploy/mysql/roles.sql（或 postgres/roles.sql）一致。
# AURACLAW_IMAGE 必须是不可变 digest 或 SHA tag，不能是 :latest。

AURACLAW_DEPLOYMENT_PROFILE=production
AURACLAW_LOG_LEVEL=INFO
AURACLAW_HOST=0.0.0.0
AURACLAW_STORAGE_BACKEND=mysql
AURACLAW_RUNTIME_EVENT_BACKEND=kafka
AURACLAW_ARTIFACT_BACKEND=seaweedfs
AURACLAW_ALLOW_INSECURE_IDENTITY_HEADERS=false
AURACLAW_WORKER_WAKE_ENABLED=true
AURACLAW_WORKER_IDLE_INTERVAL=0.25
AURACLAW_PROJECTION_WORKER_INTERVAL=0.1
AURACLAW_ORCHESTRATOR_WORKER_INTERVAL=0.1
AURACLAW_ORCHESTRATOR_LEASE_TTL_SECONDS=300
AURACLAW_CORS_ALLOW_ORIGINS=https://console.example.com

AURACLAW_IMAGE=ghcr.io/example/auraclaw:replace-with-immutable-sha
AURACLAW_INGRESS_PORT=8080
AURACLAW_INTERNAL_NETWORK=auraclaw
AURACLAW_EDGE_NETWORK=auraclaw-edge
AURACLAW_PLATFORM_NETWORK=auraclaw-platform
AURACLAW_SECRET_DIR=.runtime/compose-secrets
AURACLAW_MIGRATIONS_DIRECTORY=/app/migrations/mysql
AURACLAW_MIGRATE_TARGET=0017

# 内部 URL 由 compose.production.yml 写成服务 DNS，不必在此覆盖。
KAFKA_HOST=host.docker.internal
KAFKA_PORT=9092
AURACLAW_KAFKA_RUNTIME_TOPIC=managed-agent.runtime-events
AURACLAW_KAFKA_STREAMING_GROUP=streaming-ingestor

SEAWEEDFS_HOST=host.docker.internal
SEAWEEDFS_MASTER_PORT=9333
SEAWEEDFS_FILER_PORT=8888
SEAWEEDFS_S3_PORT=8333
SEAWEEDFS_ACCESS_KEY=replace-seaweedfs-access-key
SEAWEEDFS_SECRET_KEY=replace-seaweedfs-secret-key
SEAWEEDFS_BUCKET=auraclaw-artifacts
SEAWEEDFS_REGION=us-east-1
SEAWEEDFS_USE_SSL=false
SEAWEEDFS_PATH_STYLE=true

AURACLAW_CREDENTIAL_VAULT_ADDR=https://vault.example:8200
AURACLAW_CREDENTIAL_VAULT_TOKEN=replace-with-vault-token
AURACLAW_CREDENTIAL_VAULT_MOUNT=secret
AURACLAW_CREDENTIAL_EGRESS_ALLOWLIST=

AURACLAW_MODEL_PROVIDER=openai_compatible
AURACLAW_MODEL_API_KEY=replace-with-model-api-key
AURACLAW_MODEL_BASE_URL=https://models.example/v1
AURACLAW_MODEL_NAME=replace-with-model-name
AURACLAW_MODEL_TIMEOUT_SECONDS=120

AURACLAW_MIGRATION_DATABASE_URL=mysql+aiomysql://auraclaw_migrate:change-me@mysql:3306/auraclaw
TASK_QUERY_DATABASE_URL=mysql+aiomysql://auraclaw_task_query_ro:change-me@mysql:3306/auraclaw
SESSION_DATABASE_URL=mysql+aiomysql://auraclaw_session:change-me@mysql:3306/auraclaw
PROJECTION_DATABASE_URL=mysql+aiomysql://auraclaw_projection:change-me@mysql:3306/auraclaw
CONTROL_DATABASE_URL=mysql+aiomysql://auraclaw_control:change-me@mysql:3306/auraclaw
HANDS_DATABASE_URL=mysql+aiomysql://auraclaw_hands:change-me@mysql:3306/auraclaw
POLICY_DATABASE_URL=mysql+aiomysql://auraclaw_policy:change-me@mysql:3306/auraclaw
CREDENTIAL_DATABASE_URL=mysql+aiomysql://auraclaw_credential:change-me@mysql:3306/auraclaw
ARTIFACT_DATABASE_URL=mysql+aiomysql://auraclaw_artifact:change-me@mysql:3306/auraclaw
STREAMING_DATABASE_URL=mysql+aiomysql://auraclaw_streaming:change-me@mysql:3306/auraclaw
MODEL_DATABASE_URL=mysql+aiomysql://auraclaw_model:change-me@mysql:3306/auraclaw
DELIVERY_DATABASE_URL=mysql+aiomysql://auraclaw_delivery:change-me@mysql:3306/auraclaw

AURACLAW_LEASE_SIGNING_KEY=replace-prod-lease-signing-key-32bytes-min
AURACLAW_TASK_API_WORKLOAD_TOKEN=replace-prod-task-api-workload-token-0001
AURACLAW_PROJECTION_WORKLOAD_TOKEN=replace-prod-projection-workload-token-02
AURACLAW_ORCHESTRATOR_WORKLOAD_TOKEN=replace-prod-orchestrator-workload-tok-03
AURACLAW_RUNTIME_WORKLOAD_TOKEN=replace-prod-runtime-workload-token-0004
AURACLAW_MODEL_GATEWAY_WORKLOAD_TOKEN=replace-prod-model-gateway-workload-tok05
AURACLAW_ACTION_HANDS_WORKLOAD_TOKEN=replace-prod-action-hands-workload-tok-06
AURACLAW_CREDENTIAL_PROXY_WORKLOAD_TOKEN=replace-prod-credential-proxy-token-007
AURACLAW_ARTIFACT_SERVICE_WORKLOAD_TOKEN=replace-prod-artifact-service-token-008
AURACLAW_POLICY_WORKLOAD_TOKEN=replace-prod-policy-workload-token-00009
AURACLAW_DELIVERY_WORKLOAD_TOKEN=replace-prod-delivery-workload-token-010
AURACLAW_STREAMING_GATEWAY_WORKLOAD_TOKEN=replace-prod-streaming-gateway-workload-token-011
AURACLAW_CHAINTOWER_WORKLOAD_TOKEN=replace-prod-chaintower-workload-token-x
AURACLAW_AGENT_CONTEXT_ISSUER=chaintower
AURACLAW_AGENT_CONTEXT_AUDIENCE=auraclaw-task-api
AURACLAW_AGENT_CONTEXT_SIGNING_KEYS_JSON={"k1":"replace-chaintower-agent-context-hmac-key-01"}
AURACLAW_AGENT_CONTEXT_MAX_TTL_SECONDS=300
AURACLAW_AGENT_CONTEXT_CLOCK_SKEW_SECONDS=30
AURACLAW_AGENT_CONTEXT_REQUIRED_SCOPE=agent.task.invoke

AURACLAW_MODEL_SKILL_SOURCE_ENABLED=false
AURACLAW_MODEL_SKILL_INCLUDE_DRAFTS=false
AURACLAW_PRICE_INSIGHT_SOURCE=disabled
