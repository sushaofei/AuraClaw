# 本地 PostgreSQL 主存储凭证草稿。
# 复制为 gitignored 的 `.postgresql.local.env` 后填写真实值。
#
# 切换方式（推荐）：在 `.env.dev` / 启动环境中设置
#   AURACLAW_STORAGE_BACKEND=postgres
# 启动时会自动读取本文件的 POSTGRESQL_*，并覆盖写入 DB_*，
# 业务与 Store 代码仍只消费 DB_* / resolved_database_url（postgresql+asyncpg）。
#
# 可选：AURACLAW_POSTGRESQL_ENV_FILE=/path/to/.postgresql.local.env
# 迁移目录使用 PostgreSQL 树：
#   uv run auraclaw migrate up --directory migrations

POSTGRESQL_HOST=localhost
POSTGRESQL_PORT=5432
POSTGRESQL_DB_USER=chaintower_admin
POSTGRESQL_DB_PWD=replace-with-postgresql-password
POSTGRESQL_AURACLAW_DB=chaintower_agent
