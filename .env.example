# Copy this file to a deployment-specific ignored name such as
# .env.development or .env.production, then select it with uvicorn --env-file.
# Process and HTTP resources
AURACLAW_IMAGE=ghcr.io/example/auraclaw:replace-with-immutable-sha
AURACLAW_INGRESS_PORT=8080
AURACLAW_INTERNAL_NETWORK=auraclaw
AURACLAW_EDGE_NETWORK=auraclaw-edge
AURACLAW_PLATFORM_NETWORK=auraclaw-platform
# Gitignored 0600 files generated by scripts/materialize_compose_secrets.py.
AURACLAW_SECRET_DIR=.runtime/compose-secrets
AURACLAW_HOST=127.0.0.1
AURACLAW_PORT=8000
AURACLAW_DEPLOYMENT_PROFILE=development
AURACLAW_TASK_API_PORT=8000
AURACLAW_SESSION_PORT=8001
AURACLAW_PROJECTION_PORT=8002
AURACLAW_ORCHESTRATOR_PORT=8003
AURACLAW_RUNTIME_PORT=8004
AURACLAW_MODEL_GATEWAY_PORT=8005
AURACLAW_HANDS_PORT=8006
AURACLAW_POLICY_PORT=8007
AURACLAW_CREDENTIAL_PROXY_PORT=8008
AURACLAW_ARTIFACT_PORT=8009
AURACLAW_STREAMING_PORT=8010
AURACLAW_DELIVERY_PORT=8011
# Inject these through a Secret source in production; keep blank in committed files.
AURACLAW_LEASE_SIGNING_KEY=
AURACLAW_TASK_API_WORKLOAD_TOKEN=
AURACLAW_PROJECTION_WORKLOAD_TOKEN=
AURACLAW_ORCHESTRATOR_WORKLOAD_TOKEN=
AURACLAW_RUNTIME_WORKLOAD_TOKEN=
AURACLAW_MODEL_GATEWAY_WORKLOAD_TOKEN=
AURACLAW_ACTION_HANDS_WORKLOAD_TOKEN=
AURACLAW_CREDENTIAL_PROXY_WORKLOAD_TOKEN=
AURACLAW_ARTIFACT_SERVICE_WORKLOAD_TOKEN=
AURACLAW_POLICY_WORKLOAD_TOKEN=
AURACLAW_DELIVERY_WORKLOAD_TOKEN=
AURACLAW_LOG_LEVEL=INFO
AURACLAW_CORS_ALLOW_ORIGINS=http://127.0.0.1:3000,http://localhost:3000,http://127.0.0.1:3001,http://localhost:3001
AURACLAW_RUNTIME_ENABLED=true
AURACLAW_RUNTIME_POLL_INTERVAL=0.05
AURACLAW_ORCHESTRATOR_LEASE_TTL_SECONDS=300
AURACLAW_RUNTIME_ID=runtime-local-1
AURACLAW_RUNTIME_ROLE=root
AURACLAW_RUNTIME_NODE_ID=local
AURACLAW_RUNTIME_CAPACITY=1

# Internal owner endpoints. Compose replaces localhost with service DNS names.
AURACLAW_SESSION_BASE_URL=http://127.0.0.1:8001
AURACLAW_PROJECTION_BASE_URL=http://127.0.0.1:8002
AURACLAW_CONTROL_BASE_URL=http://127.0.0.1:8003
AURACLAW_MODEL_GATEWAY_BASE_URL=http://127.0.0.1:8005
AURACLAW_HANDS_MCP_URL=http://127.0.0.1:8006/mcp
AURACLAW_POLICY_BASE_URL=http://127.0.0.1:8007
AURACLAW_CREDENTIAL_PROXY_BASE_URL=http://127.0.0.1:8008
AURACLAW_CREDENTIAL_EGRESS_ALLOWLIST=
AURACLAW_CREDENTIAL_VAULT_ADDR=
AURACLAW_CREDENTIAL_VAULT_TOKEN=
AURACLAW_CREDENTIAL_VAULT_MOUNT=secret
# Optional integration-test reference containing a disposable non-production value.
TEST_VAULT_CREDENTIAL_REF=
TEST_VAULT_CREDENTIAL_FIELD=
AURACLAW_ARTIFACT_BASE_URL=http://127.0.0.1:8009
AURACLAW_DELIVERY_BASE_URL=http://127.0.0.1:8011

# Storage resources. Each deployment supplies its own values.
AURACLAW_STORAGE_BACKEND=memory
AURACLAW_DATABASE_URL=postgresql+asyncpg://auraclaw:auraclaw@localhost:5432/auraclaw
# Deployment-only owner/admin DSN used by `auraclaw migrate`; never inject into services.
AURACLAW_MIGRATION_DATABASE_URL=
# Existing deployments may provide the equivalent split settings instead.
DB_HOST=localhost
DB_PORT=5432
DB_USER=auraclaw
DB_PWD=change-me
DB_NAME=auraclaw
# Production role-scoped DSNs. Values remain blank in committed files.
TASK_QUERY_DATABASE_URL=
SESSION_DATABASE_URL=
PROJECTION_DATABASE_URL=
CONTROL_DATABASE_URL=
HANDS_DATABASE_URL=
POLICY_DATABASE_URL=
CREDENTIAL_DATABASE_URL=
ARTIFACT_DATABASE_URL=
STREAMING_DATABASE_URL=
MODEL_DATABASE_URL=
DELIVERY_DATABASE_URL=
# Artifact object storage. "auto" selects SeaweedFS when SEAWEEDFS_HOST is present;
# use "local" for filesystem-only development.
AURACLAW_ARTIFACT_BACKEND=auto
AURACLAW_ARTIFACT_ROOT=.data/artifacts
SEAWEEDFS_HOST=localhost
SEAWEEDFS_MASTER_PORT=9333
SEAWEEDFS_FILER_PORT=8888
SEAWEEDFS_S3_PORT=8333
SEAWEEDFS_ACCESS_KEY=
SEAWEEDFS_SECRET_KEY=
SEAWEEDFS_BUCKET=auraclaw-artifacts
SEAWEEDFS_REGION=us-east-1
SEAWEEDFS_USE_SSL=false
SEAWEEDFS_PATH_STYLE=true
AURACLAW_ARTIFACT_MULTIPART_THRESHOLD=16777216
AURACLAW_ARTIFACT_MULTIPART_PART_SIZE=8388608

# Runtime events. "auto" selects Kafka when KAFKA_HOST is present; use "memory" for local-only tests.
AURACLAW_RUNTIME_EVENT_BACKEND=auto
KAFKA_HOST=localhost
KAFKA_PORT=9092
AURACLAW_KAFKA_RUNTIME_TOPIC=managed-agent.runtime-events
AURACLAW_KAFKA_STREAMING_GROUP=streaming-ingestor
AURACLAW_RUNTIME_EVENT_RETENTION_EVENTS=1000
AURACLAW_STREAM_CONNECTION_QUEUE_SIZE=128

# Provider-neutral model configuration. The Base URL should expose an
# OpenAI-compatible /chat/completions endpoint (for example https://host/v1).
# Credentials are resolved inside Model Gateway and never passed to Agent Runtime.
AURACLAW_MODEL_PROVIDER=openai_compatible
AURACLAW_MODEL_API_KEY=
AURACLAW_MODEL_BASE_URL=https://models.example/v1
AURACLAW_MODEL_NAME=
AURACLAW_MODEL_TIMEOUT_SECONDS=120
# Optional thinking mode for GLM/TokenHub-compatible APIs.
# true -> thinking.type=enabled; false -> thinking.type=disabled; omit for provider default.
# AURACLAW_MODEL_THINKING_ENABLED=false
