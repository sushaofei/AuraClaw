# Application
AURACLAW_ENV=development
AURACLAW_HOST=127.0.0.1
AURACLAW_PORT=8000
AURACLAW_LOG_LEVEL=INFO

# Storage. The initial development adapter is in-memory.
AURACLAW_STORAGE_BACKEND=memory
AURACLAW_DATABASE_URL=postgresql+asyncpg://auraclaw:auraclaw@localhost:5432/auraclaw
# Existing deployments may provide the equivalent split settings instead.
DB_HOST=localhost
DB_PORT=5432
DB_USER=auraclaw
DB_PWD=change-me
DB_NAME_DEV=auraclaw_test
DB_NAME_PRO=auraclaw
AURACLAW_ARTIFACT_ROOT=.data/artifacts

# Model providers are consumed by the future Model Gateway only.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
