# Copy this file to a deployment-specific ignored name such as
# .env.development or .env.production, then select it with uvicorn --env-file.
# Process and HTTP resources
AURACLAW_HOST=127.0.0.1
AURACLAW_PORT=8000
AURACLAW_LOG_LEVEL=INFO
AURACLAW_CORS_ALLOW_ORIGINS=http://127.0.0.1:3000,http://localhost:3000,http://127.0.0.1:3001,http://localhost:3001
AURACLAW_RUNTIME_ENABLED=true
AURACLAW_RUNTIME_POLL_INTERVAL=0.05

# Storage resources. Each deployment supplies its own values.
AURACLAW_STORAGE_BACKEND=memory
AURACLAW_DATABASE_URL=postgresql+asyncpg://auraclaw:auraclaw@localhost:5432/auraclaw
# Existing deployments may provide the equivalent split settings instead.
DB_HOST=localhost
DB_PORT=5432
DB_USER=auraclaw
DB_PWD=change-me
DB_NAME=auraclaw
AURACLAW_ARTIFACT_ROOT=.data/artifacts

# Runtime events. "auto" selects Kafka when KAFKA_HOST is present; use "memory" for local-only tests.
AURACLAW_RUNTIME_EVENT_BACKEND=auto
KAFKA_HOST=localhost
KAFKA_PORT=9092
AURACLAW_KAFKA_RUNTIME_TOPIC=managed-agent.runtime-events
AURACLAW_KAFKA_STREAMING_GROUP=streaming-ingestor
AURACLAW_RUNTIME_EVENT_RETENTION_EVENTS=1000
AURACLAW_STREAM_CONNECTION_QUEUE_SIZE=128

# Provider-neutral model configuration. The Base URL should expose an
# OpenAI-compatible /chat/completions endpoint (for example https://host/v1).
# Credentials are resolved inside Model Gateway and never passed to Agent Runtime.
AURACLAW_MODEL_PROVIDER=openai_compatible
AURACLAW_MODEL_API_KEY=
AURACLAW_MODEL_BASE_URL=https://models.example/v1
AURACLAW_MODEL_NAME=
AURACLAW_MODEL_TIMEOUT_SECONDS=120
