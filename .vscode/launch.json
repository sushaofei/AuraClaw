{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "AuraClaw serve",
      "type": "debugpy",
      "request": "launch",
      "module": "auraclaw",
      "args": ["serve", "--host", "0.0.0.0"],
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/.venv/bin/python",
      "envFile": "${workspaceFolder}/.env.dev",
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      "name": "AuraClaw serve (PostgreSQL)",
      "type": "debugpy",
      "request": "launch",
      "module": "auraclaw",
      "args": ["serve", "--host", "0.0.0.0"],
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/.venv/bin/python",
      "envFile": "${workspaceFolder}/.env.dev",
      "env": {
        "AURACLAW_STORAGE_BACKEND": "postgres"
      },
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      "name": "AuraClaw serve (KingBase)",
      "type": "debugpy",
      "request": "launch",
      "module": "auraclaw",
      "args": ["serve", "--host", "0.0.0.0"],
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/.venv/bin/python",
      "envFile": "${workspaceFolder}/.env.dev",
      "env": {
        "AURACLAW_STORAGE_BACKEND": "kingbase"
      },
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      "name": "AuraMCP run",
      "type": "debugpy",
      "request": "launch",
      "module": "auramcp",
      "args": ["run", "--host", "127.0.0.1", "--port", "8020"],
      "cwd": "${workspaceFolder}/../AuraMCP",
      "python": "${workspaceFolder}/../AuraMCP/.venv/bin/python",
      "envFile": "${workspaceFolder}/../AuraMCP/.env",
      "console": "integratedTerminal",
      "justMyCode": false
    }
  ],
  "compounds": [
    {
      "name": "AuraClaw + AuraMCP",
      "configurations": ["AuraClaw serve", "AuraMCP run"],
      "stopAll": true
    },
    {
      "name": "AuraClaw (PostgreSQL) + AuraMCP",
      "configurations": ["AuraClaw serve (PostgreSQL)", "AuraMCP run"],
      "stopAll": true
    },
    {
      "name": "AuraClaw (KingBase) + AuraMCP",
      "configurations": ["AuraClaw serve (KingBase)", "AuraMCP run"],
      "stopAll": true
    }
  ]
}
