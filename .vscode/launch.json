{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "AuraClaw serve",
      "type": "debugpy",
      "request": "launch",
      "module": "auraclaw",
      "args": ["serve", "--host", "127.0.0.1"],
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/.venv/bin/python",
      "envFile": "${workspaceFolder}/.env.dev",
      "console": "integratedTerminal",
      "justMyCode": false
    }
  ]
}
