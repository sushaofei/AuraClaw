# 本地开发环境（非 Docker，`uv run auraclaw serve` / VS Code debug）。
#
#   cp .env.dev.example .env.dev
#   uv run auraclaw serve          # 12 入口 8000–8011 + 本地 Ingress 8080
#
# 与 .env.test 除大模型 AURACLAW_MODEL_API_KEY / AURACLAW_MODEL_BASE_URL / AURACLAW_MODEL_NAME
# 及下列本地运行拓扑项外保持一致：
#   DEPLOYMENT_PROFILE、HOST、ALLOW_INSECURE_IDENTITY_HEADERS、12 入口 URL、
#   NO_PROXY（仅本地开发：绕过本机 HTTP 代理访问内网中间件；test/prod 不要配置）。
# Java MCP：复制 debug/java-mcp-servers.example.json → debug/java-mcp-servers.json
# 后取消下方 MCP 段注释，再启动 Hands: Java MCP reconcile。

# --- 进程与策略 ---
AURACLAW_DEPLOYMENT_PROFILE=development
AURACLAW_LOG_LEVEL=INFO
AURACLAW_HOST=127.0.0.1
AURACLAW_STORAGE_BACKEND=mysql
AURACLAW_RUNTIME_EVENT_BACKEND=kafka
AURACLAW_ARTIFACT_BACKEND=seaweedfs
AURACLAW_ALLOW_INSECURE_IDENTITY_HEADERS=true
AURACLAW_WORKER_WAKE_ENABLED=true
AURACLAW_WORKER_IDLE_INTERVAL=0.25
AURACLAW_PROJECTION_WORKER_INTERVAL=0.1
AURACLAW_ORCHESTRATOR_WORKER_INTERVAL=0.1
AURACLAW_ORCHESTRATOR_LEASE_TTL_SECONDS=300
AURACLAW_CORS_ALLOW_ORIGINS=http://10.244.16.130:3000,http://127.0.0.1:3000,http://localhost:3000
AURACLAW_RUNTIME_ENABLED=true
AURACLAW_RUNTIME_POLL_INTERVAL=0.05
AURACLAW_PORT=8000
AURACLAW_RUNTIME_ID=runtime-local-1
AURACLAW_RUNTIME_ROLE=root
AURACLAW_RUNTIME_NODE_ID=local
AURACLAW_RUNTIME_CAPACITY=1
AURACLAW_INGRESS_ENABLED=true
AURACLAW_INGRESS_PORT=8080

# --- Compose / 发布（本地 serve 不使用，键与 test 对齐）---
AURACLAW_IMAGE=auraclaw:dev
AURACLAW_INTERNAL_NETWORK=auraclaw
AURACLAW_EDGE_NETWORK=auraclaw-edge
AURACLAW_PLATFORM_NETWORK=auraclaw-platform
AURACLAW_SECRET_DIR=.runtime/compose-secrets
AURACLAW_MIGRATIONS_DIRECTORY=migrations/mysql
AURACLAW_MIGRATE_TARGET=0017

# --- 本地 12 入口 ---
# Java 智问代理应指向统一入口 8080，不要直连 Task API 8000。
AURACLAW_TASK_API_PORT=8000
AURACLAW_SESSION_PORT=8001
AURACLAW_PROJECTION_PORT=8002
AURACLAW_ORCHESTRATOR_PORT=8003
AURACLAW_RUNTIME_PORT=8004
AURACLAW_MODEL_GATEWAY_PORT=8005
AURACLAW_HANDS_PORT=8006
AURACLAW_POLICY_PORT=8007
AURACLAW_CREDENTIAL_PROXY_PORT=8008
AURACLAW_ARTIFACT_PORT=8009
AURACLAW_STREAMING_PORT=8010
AURACLAW_DELIVERY_PORT=8011
AURACLAW_SESSION_BASE_URL=http://127.0.0.1:8001
AURACLAW_PROJECTION_BASE_URL=http://127.0.0.1:8002
AURACLAW_CONTROL_BASE_URL=http://127.0.0.1:8003
AURACLAW_RUNTIME_BASE_URL=http://127.0.0.1:8004
AURACLAW_MODEL_GATEWAY_BASE_URL=http://127.0.0.1:8005
AURACLAW_HANDS_URL=http://127.0.0.1:8006
AURACLAW_POLICY_BASE_URL=http://127.0.0.1:8007
AURACLAW_CREDENTIAL_PROXY_BASE_URL=http://127.0.0.1:8008
AURACLAW_ARTIFACT_BASE_URL=http://127.0.0.1:8009
AURACLAW_DELIVERY_BASE_URL=http://127.0.0.1:8011

# --- Kafka（DEV_MIDDLEWARE @ 10.244.16.132）---
KAFKA_HOST=10.244.16.132
KAFKA_PORT=9092
AURACLAW_KAFKA_RUNTIME_TOPIC=managed-agent.runtime-events
AURACLAW_KAFKA_STREAMING_GROUP=streaming-ingestor
AURACLAW_RUNTIME_EVENT_RETENTION_EVENTS=1000
AURACLAW_STREAM_CONNECTION_QUEUE_SIZE=128

# --- SeaweedFS / Artifact ---
SEAWEEDFS_HOST=10.244.16.132
SEAWEEDFS_MASTER_PORT=9333
SEAWEEDFS_FILER_PORT=8888
SEAWEEDFS_S3_PORT=8333
SEAWEEDFS_ACCESS_KEY=replace-seaweedfs-access-key
SEAWEEDFS_SECRET_KEY=replace-seaweedfs-secret-key
SEAWEEDFS_BUCKET=auraclaw-artifacts
SEAWEEDFS_REGION=us-east-1
SEAWEEDFS_USE_SSL=false
SEAWEEDFS_PATH_STYLE=true
AURACLAW_ARTIFACT_ROOT=.data/artifacts
AURACLAW_ARTIFACT_MULTIPART_THRESHOLD=16777216
AURACLAW_ARTIFACT_MULTIPART_PART_SIZE=8388608

# --- Vault ---
AURACLAW_CREDENTIAL_VAULT_ADDR=http://127.0.0.1:8200
AURACLAW_CREDENTIAL_VAULT_TOKEN=replace-with-vault-token
AURACLAW_CREDENTIAL_VAULT_MOUNT=secret
AURACLAW_CREDENTIAL_EGRESS_ALLOWLIST=
TEST_VAULT_CREDENTIAL_REF=test/auraclaw-credentials
TEST_VAULT_CREDENTIAL_FIELD=password

# --- Model（本地开发；与 .env.test 仅此段不同）---
AURACLAW_MODEL_PROVIDER=openai_compatible
AURACLAW_MODEL_API_KEY=
AURACLAW_MODEL_BASE_URL=
AURACLAW_MODEL_NAME=
AURACLAW_MODEL_TIMEOUT_SECONDS=120
AURACLAW_MODEL_THINKING_ENABLED=false
AURACLAW_DEVELOPMENT_MODEL_MODE=provider

# --- Database（主库 auraclaw_dev @ 10.244.16.133）---
AURACLAW_DB_DIALECT=mysql
DB_HOST=10.244.16.133
DB_PORT=3306
DB_USER=root
DB_PWD=replace-with-mysql-password
DB_NAME=auraclaw_dev
AURACLAW_DATABASE_URL=mysql+aiomysql://root:replace-with-mysql-password@10.244.16.133:3306/auraclaw_dev
AURACLAW_MIGRATION_DATABASE_URL=mysql+aiomysql://root:replace-with-mysql-password-url-encoded@10.244.16.133:3306/auraclaw_dev
TASK_QUERY_DATABASE_URL=mysql+aiomysql://auraclaw_task_query_ro:replace-role-password@10.244.16.133:3306/auraclaw_dev
SESSION_DATABASE_URL=mysql+aiomysql://auraclaw_session:replace-role-password@10.244.16.133:3306/auraclaw_dev
PROJECTION_DATABASE_URL=mysql+aiomysql://auraclaw_projection:replace-role-password@10.244.16.133:3306/auraclaw_dev
CONTROL_DATABASE_URL=mysql+aiomysql://auraclaw_control:replace-role-password@10.244.16.133:3306/auraclaw_dev
HANDS_DATABASE_URL=mysql+aiomysql://auraclaw_hands:replace-role-password@10.244.16.133:3306/auraclaw_dev
POLICY_DATABASE_URL=mysql+aiomysql://auraclaw_policy:replace-role-password@10.244.16.133:3306/auraclaw_dev
CREDENTIAL_DATABASE_URL=mysql+aiomysql://auraclaw_credential:replace-role-password@10.244.16.133:3306/auraclaw_dev
ARTIFACT_DATABASE_URL=mysql+aiomysql://auraclaw_artifact:replace-role-password@10.244.16.133:3306/auraclaw_dev
STREAMING_DATABASE_URL=mysql+aiomysql://auraclaw_streaming:replace-role-password@10.244.16.133:3306/auraclaw_dev
MODEL_DATABASE_URL=mysql+aiomysql://auraclaw_model:replace-role-password@10.244.16.133:3306/auraclaw_dev
DELIVERY_DATABASE_URL=mysql+aiomysql://auraclaw_delivery:replace-role-password@10.244.16.133:3306/auraclaw_dev

# --- Model Skill / Price Insight（只读 chaintower_db）---
MYSQL_DB_HOST=10.244.16.133
MYSQL_DB_PORT=3306
MYSQL_DB_USER=root
MYSQL_DB_PWD=replace-with-mysql-password
MYSQL_DB_NAME=chaintower_db
AURACLAW_MODEL_SKILL_SOURCE_ENABLED=true
AURACLAW_MODEL_SKILL_SOURCE_TENANT_ID=1
AURACLAW_MODEL_SKILL_TARGET_TENANT_ID=development
AURACLAW_MODEL_SKILL_INCLUDE_DRAFTS=false
AURACLAW_MODEL_SKILL_RECONCILE_INTERVAL_SECONDS=60
AURACLAW_MODEL_SKILL_SIGNING_KEY=
AURACLAW_PRICE_INSIGHT_SOURCE=mysql
AURACLAW_PRICE_INSIGHT_TARGET_TENANT_ID=development
AURACLAW_PRICE_INSIGHT_MYSQL_HOST=10.244.16.133
AURACLAW_PRICE_INSIGHT_MYSQL_PORT=3306
AURACLAW_PRICE_INSIGHT_MYSQL_USER=root
AURACLAW_PRICE_INSIGHT_MYSQL_PASSWORD=replace-with-mysql-password
AURACLAW_PRICE_INSIGHT_MYSQL_DATABASE=chaintower_db

# --- Workload tokens / Agent Context ---
AURACLAW_LEASE_SIGNING_KEY=replace-test-lease-signing-key-32bytes-minimum
AURACLAW_TASK_API_WORKLOAD_TOKEN=replace-test-task-api-workload-token-0001
AURACLAW_PROJECTION_WORKLOAD_TOKEN=replace-test-projection-workload-token-02
AURACLAW_ORCHESTRATOR_WORKLOAD_TOKEN=replace-test-orchestrator-workload-tok-03
AURACLAW_RUNTIME_WORKLOAD_TOKEN=replace-test-runtime-workload-token-0004
AURACLAW_MODEL_GATEWAY_WORKLOAD_TOKEN=replace-test-model-gateway-workload-tok05
AURACLAW_ACTION_HANDS_WORKLOAD_TOKEN=replace-test-action-hands-workload-tok-06
AURACLAW_CREDENTIAL_PROXY_WORKLOAD_TOKEN=replace-test-credential-proxy-token-007
AURACLAW_ARTIFACT_SERVICE_WORKLOAD_TOKEN=replace-test-artifact-service-token-008
AURACLAW_POLICY_WORKLOAD_TOKEN=replace-test-policy-workload-token-00009
AURACLAW_DELIVERY_WORKLOAD_TOKEN=replace-test-delivery-workload-token-010
AURACLAW_STREAMING_GATEWAY_WORKLOAD_TOKEN=replace-test-streaming-gateway-workload-token-011
AURACLAW_CHAINTOWER_WORKLOAD_TOKEN=replace-test-chaintower-workload-token-x
AURACLAW_AGENT_CONTEXT_ISSUER=chaintower
AURACLAW_AGENT_CONTEXT_AUDIENCE=auraclaw-task-api
AURACLAW_AGENT_CONTEXT_SIGNING_KEYS_JSON={"k1":"replace-chaintower-agent-context-hmac-key-01"}
AURACLAW_AGENT_CONTEXT_MAX_TTL_SECONDS=300
AURACLAW_AGENT_CONTEXT_CLOCK_SKEW_SECONDS=30
AURACLAW_AGENT_CONTEXT_REQUIRED_SCOPE=agent.task.invoke

# --- 本地开发专用：HTTP 代理绕过（test / prod 不要复制）---
# 本机若设置了 HTTP(S)_PROXY，访问内网 Kafka/MySQL/SeaweedFS/Vault 需走直连。
# auraclaw 启动时仅在加载 .env.dev 时应用；也可用 AURACLAW_MODEL_USE_PROXY=1 保留代理。
NO_PROXY=10.244.16.131,10.244.16.132,10.244.16.133,10.244.16.134,127.0.0.1,localhost
no_proxy=10.244.16.131,10.244.16.132,10.244.16.133,10.244.16.134,127.0.0.1,localhost

# --- Redis ---
REDIS_HOST=10.244.16.134
REDIS_PORT=6379
REDIS_DB=0
REDIS_PWD=replace-with-redis-password

# --- 可选：Hands MCP egress ---
# AURACLAW_MCP_EGRESS_SERVERS_JSON=[]
# AURACLAW_MCP_EGRESS_SERVERS_FILE=debug/java-mcp-servers.json
# AURACLAW_DEBUG_VAULT_SECRETS_JSON={}

# --- 可选：Java MCP reconcile ---
# AURACLAW_MCP_RECONCILE_INTERVAL_SECONDS=15
# AURACLAW_MCP_EGRESS_SERVERS_FILE=debug/java-mcp-servers.json
