{
  "name": "semantic-query",
  "publisher": "aura-semantic",
  "version": "1.0.0",
  "description": "基于已授权业务语义模型问数，发现指标口径、查询并解释结果。",
  "applies_when": ["用户需要业务指标、地区统计、金额汇总或时间范围分析"],
  "not_when": ["修改业务数据", "修改线上指标模型", "查询未授权数据"],
  "required_tools": [
    {"name": "auramcp.semantic.discover", "version": ">=1.0.0,<2.0.0"},
    {"name": "auramcp.semantic.describe", "version": ">=1.0.0,<2.0.0"},
    {"name": "auramcp.semantic.query", "version": ">=1.0.0,<2.0.0"}
  ],
  "allowed_roles": ["coordinator", "worker"],
  "data_classification": "internal",
  "risk_level": "low",
  "max_steps": 12,
  "timeout_seconds": 120
}
