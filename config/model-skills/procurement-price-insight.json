{
  "model": {
    "model_code": "PRICE_IMPACT",
    "model_name": "采购价格洞察模型",
    "model_type": "ANALYTICS",
    "target_type": "PRICE",
    "business_domain": "PROCUREMENT_PRICE_INSIGHT",
    "description": "基于最终成交价、行业基准、匹配证据和规则配置生成历史、区域、市场及价格影响洞察。"
  },
  "version": {
    "version_no": "4.0.0",
    "version_name": "配置治理价格洞察 Skill",
    "change_log": "补齐解释优先级权重、场景发现标签和装载开关；DWD 规则作为 Tool 阈值与质量门禁的唯一业务规则来源。"
  },
  "input_sources": [
    {
      "source_code": "PRICE_EVENT_DWD",
      "source_name": "最终成交价格明细",
      "source_type": "MYSQL_DWD",
      "source_config_json": {
        "logical_table": "dwd_pr_price_event_detail_di",
        "adapter": "price_insight",
        "access_mode": "READ_ONLY",
        "tenant_scoped": true
      }
    },
    {
      "source_code": "INDUSTRY_BENCHMARK_DWD",
      "source_name": "行业价格基准",
      "source_type": "MYSQL_DWD",
      "source_config_json": {
        "logical_table": "dwd_pr_industry_price_benchmark_di",
        "adapter": "price_insight",
        "access_mode": "READ_ONLY",
        "tenant_scoped": true
      }
    },
    {
      "source_code": "PRICE_COMPARE_DWD",
      "source_name": "成交价行业基准匹配证据",
      "source_type": "MYSQL_DWD",
      "source_config_json": {
        "logical_table": "dwd_pr_price_compare_pair_di",
        "adapter": "price_insight",
        "access_mode": "READ_ONLY",
        "tenant_scoped": true
      }
    },
    {
      "source_code": "PRICE_RULE_DWD",
      "source_name": "价格洞察规则",
      "source_type": "MYSQL_DWD",
      "source_config_json": {
        "logical_table": "dwd_pr_price_insight_rule_di",
        "adapter": "price_insight",
        "access_mode": "READ_ONLY",
        "tenant_scoped": true
      }
    }
  ],
  "input_features": [
    {
      "feature_code": "period_from",
      "feature_name": "起始月份",
      "feature_data_type": "STRING",
      "source_type": "REQUEST",
      "source_expression": "filter.period_from",
      "required_flag": true,
      "sort_order": 1
    },
    {
      "feature_code": "period_to",
      "feature_name": "结束月份",
      "feature_data_type": "STRING",
      "source_type": "REQUEST",
      "source_expression": "filter.period_to",
      "required_flag": true,
      "sort_order": 2
    },
    {
      "feature_code": "anchor",
      "feature_name": "对标锚点",
      "feature_data_type": "STRING",
      "source_type": "REQUEST",
      "source_expression": "filter.anchor",
      "default_value": "history",
      "required_flag": false,
      "sort_order": 3
    },
    {
      "feature_code": "deviation_threshold_pct",
      "feature_name": "偏离阈值百分比",
      "feature_data_type": "NUMBER",
      "source_type": "REQUEST",
      "source_expression": "filter.deviation_threshold_pct",
      "default_value": "8",
      "required_flag": false,
      "sort_order": 4
    }
  ],
  "output_schemas": [
    {"output_code": "history_dev_pct", "output_name": "历史维偏离", "data_type": "NUMBER", "required_flag": true, "sort_order": 1},
    {"output_code": "region_gap_max", "output_name": "区域维价差", "data_type": "NUMBER", "required_flag": true, "sort_order": 2},
    {"output_code": "market_dev_pct", "output_name": "市场维偏离", "data_type": "NUMBER", "required_flag": true, "sort_order": 3},
    {"output_code": "impact_amount", "output_name": "正偏移金额", "data_type": "NUMBER", "required_flag": true, "sort_order": 4},
    {"output_code": "impact_neg_amount", "output_name": "负偏移金额", "data_type": "NUMBER", "required_flag": true, "sort_order": 5},
    {"output_code": "impact_share_pct", "output_name": "正偏移占采购额", "data_type": "NUMBER", "required_flag": true, "sort_order": 6},
    {"output_code": "impact_neg_share_pct", "output_name": "负偏移占采购额", "data_type": "NUMBER", "required_flag": true, "sort_order": 7},
    {"output_code": "deviation_cnt", "output_name": "市场偏离行", "data_type": "INTEGER", "required_flag": true, "sort_order": 8},
    {"output_code": "source_revision", "output_name": "数据修订版本", "data_type": "STRING", "required_flag": true, "sort_order": 9},
    {"output_code": "quality_status", "output_name": "数据质量状态", "data_type": "STRING", "required_flag": true, "sort_order": 10}
  ],
  "weights": [
