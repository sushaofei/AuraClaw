  "switch": {
    "switch_code": "price_insight_agent",
    "switch_name": "价格洞察智能体开关",
    "scene_code": "PRICE_MANAGEMENT_CONTROL_TOWER",
    "enabled": true,
    "priority": 100,
    "remark": "PRICE_MANAGEMENT_CONTROL_TOWER 场景唯一根 Skill 装载开关。"
  },
  "auraclaw_skill": {
    "schema_version": "auraclaw.model-skill/v2",
    "execution_profile": "procurement-price-insight-atomic-v1",
    "name": "procurement.price-insight.generate",
    "description": "以受治理 DWD 数据逐项生成采购价格历史、区域、市场和价格影响洞察。",
    "applies_when": [
      "采购价格或价格管理控制塔分析",
      "历史价格变化或跨区域价差",
      "行业均价横向对标",
      "价格影响金额、占比或异常明细"
    ],
    "not_when": [
      "要求修改采购订单或直接执行调价",
      "月份范围缺失",
      "数据质量状态为 blocked"
    ],
    "input_schema": {
      "type": "object",
      "properties": {
        "period_from": {"type": "string", "pattern": "^\\d{4}-(0[1-9]|1[0-2])$"},
        "period_to": {"type": "string", "pattern": "^\\d{4}-(0[1-9]|1[0-2])$"},
        "org_codes": {"type": "array", "items": {"type": "string"}},
        "region_codes": {"type": "array", "items": {"type": "string"}},
        "category_codes": {"type": "array", "items": {"type": "string"}},
        "material_codes": {"type": "array", "items": {"type": "string"}},
        "benchmark_version": {"type": "string"},
        "rule_version": {"type": "string"},
        "anchor": {"type": "string", "enum": ["history", "region", "market"]},
        "deviation_threshold_pct": {"type": "number", "minimum": 0, "maximum": 1000}
      },
      "additionalProperties": false
    },
    "output_schema": {
      "type": "object",
      "properties": {
        "filter": {"type": "object"},
        "source_revision": {"type": "string"},
        "data_quality": {"type": "object"},
        "metrics": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {"type": "object"}
        },
        "evidence": {"type": "array"},
        "limitations": {"type": "array", "items": {"type": "string"}}
      },
      "required": ["filter", "source_revision", "data_quality", "metrics", "evidence"],
      "additionalProperties": false
    },
    "required_tools": [],
    "required_skills": [
      {
        "name": "procurement.price-data.validate",
        "version": "1.0.0",
        "publisher": "platform"
      },
      {
        "name": "procurement.price-metrics.analyze",
        "version": "1.0.0",
        "publisher": "platform"
      }
    ],
    "data_tables": [
      "dwd_pr_price_event_detail_di",
      "dwd_pr_industry_price_benchmark_di",
      "dwd_pr_price_compare_pair_di",
      "dwd_pr_price_insight_rule_di"
    ],
    "metric_keys": [
      "history_dev_pct",
      "region_gap_max",
      "market_dev_pct",
      "impact_amount",
      "impact_neg_amount",
      "impact_share_pct",
      "impact_neg_share_pct",
      "deviation_cnt"
    ],
    "allowed_roles": ["root", "coordinator", "worker"],
    "data_classification": "internal",
    "risk_level": "low",
    "max_steps": 30,
    "timeout_seconds": 120
  }
}
