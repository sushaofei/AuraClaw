# Copy to .env.hands-debug (gitignored) before launching
# "Hands: Java MCP reconcile". Fill in the Java MCP URL, OAuth and secret.
# Standalone service debug uses .env.debug; this file is MCP-only.
#
#   cp .env.hands-debug.example .env.hands-debug
#   cp debug/java-mcp-servers.example.json debug/java-mcp-servers.json

AURACLAW_DEPLOYMENT_PROFILE=development
AURACLAW_LOG_LEVEL=DEBUG
AURACLAW_STORAGE_BACKEND=memory
AURACLAW_HOST=127.0.0.1
AURACLAW_HANDS_PORT=8006
AURACLAW_POLICY_PORT=8007
AURACLAW_CREDENTIAL_PROXY_PORT=8008
AURACLAW_POLICY_BASE_URL=http://127.0.0.1:8007
AURACLAW_CREDENTIAL_PROXY_BASE_URL=http://127.0.0.1:8008
AURACLAW_MCP_RECONCILE_INTERVAL_SECONDS=15
AURACLAW_MCP_EGRESS_SERVERS_FILE=debug/java-mcp-servers.json

# credential_ref in java-mcp-servers.json must match a key here.
# Value is the OAuth client_secret; it never goes into the Server JSON.
AURACLAW_DEBUG_VAULT_SECRETS_JSON={"vault/java-mcp#client_secret":"replace-with-java-mcp-client-secret"}
