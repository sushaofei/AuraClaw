# KingBase V9（PostgreSQL 兼容模式）主存储凭证草稿。
# 复制为 gitignored 的 `.kingbase.env` 后填写真实值。
#
# 切换方式（推荐）：在 `.env.dev` / 启动环境中设置
#   AURACLAW_STORAGE_BACKEND=kingbase
# 启动时会自动读取本文件的 KINGBASE_*，并覆盖写入 DB_*，
# 业务与 Store 代码仍只消费 DB_* / resolved_database_url（postgresql+asyncpg）。
#
# 可选：AURACLAW_KINGBASE_ENV_FILE=/path/to/.kingbase.env
# 迁移目录使用 PostgreSQL 树：
#   uv run auraclaw migrate up --directory migrations

KINGBASE_VERSION=V9
KINGBASE_PARTNER=PostgreSQL
KINGBASE_HOST=127.0.0.1
KINGBASE_PORT=54321
KINGBASE_DB_USER=replace-with-kingbase-user
KINGBASE_DB_PWD=replace-with-kingbase-password
KINGBASE_AURACLAW_DB=auraclaw_dev
